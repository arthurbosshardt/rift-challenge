# Copier vers .env (gitignored). Ne jamais committer les vraies valeurs.

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# JWT Secret (legacy HS256) — Project Settings > JWT Keys
SUPABASE_JWT_SECRET=

# Supabase — Project Settings > Database > Connect > Session pooler (hébergement cloud)
# Ne pas utiliser db.xxx.supabase.co (direct IPv6) depuis Render : "Network unreachable"
# Exemple JDBC :
# DATABASE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.VOTRE_PROJECT_REF
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=

# Riot (backend only)
RIOT_API_KEY=
RIOT_APP_ID=
RIOT_REGIONAL_ROUTING=europe
RIOT_PLATFORM=euw1

SPRING_PROFILES_ACTIVE=local
CORS_ORIGINS=http://localhost:4200

# Prod (Render/Vercel) : renseigner les URLs réelles après le 1er déploiement
# CORS_ORIGINS=https://xxx.vercel.app
# API_BASE_URL=https://xxx.onrender.com  (variable Vercel, build front)

# Front local : copier SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY dans
# frontend/src/environments/environment.ts (gitignored)
