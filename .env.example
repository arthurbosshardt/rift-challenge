# Copier vers .env (gitignored). Ne jamais committer les vraies valeurs.

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Supabase — Project Settings > Database > Connect > Session pooler (hébergement cloud)
# Ne pas utiliser db.xxx.supabase.co (direct IPv6) depuis Render : "Network unreachable"
# Exemple JDBC :
# DATABASE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.VOTRE_PROJECT_REF
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
# Session pooler Supabase ≈ 15 clients partagés. Ne pas monter sans vérifier cette limite.
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1

# Riot (backend only — jamais exposé au frontend)
RIOT_API_KEY=
RIOT_REGIONAL_ROUTING=europe
# La plateforme (euw1, na1, ...) est choisie par challenge en base, pas ici.

SPRING_PROFILES_ACTIVE=local
CORS_ORIGINS=http://localhost:4200

# Prod (Render/Vercel + domaine custom)
# CORS_ORIGINS=https://rift-challenge.com,https://www.rift-challenge.com
# API_BASE_URL=https://<ton-service>.onrender.com  (variable Vercel, build front)

# Front local : copier SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY dans
# frontend/src/environments/environment.ts (gitignored, généré par
# frontend/scripts/write-local-env.mjs à partir de ce .env)
