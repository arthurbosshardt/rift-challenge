# Copier vers .env (gitignored). Ne jamais committer les vraies valeurs.

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# JWT Secret (legacy HS256) — Project Settings > JWT Keys
SUPABASE_JWT_SECRET=

# Supabase — Project Settings > Database > Connection string (URI)
# Exemple JDBC : jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=

# Riot (backend only)
RIOT_API_KEY=
RIOT_APP_ID=
RIOT_REGIONAL_ROUTING=europe
RIOT_PLATFORM=euw1

SPRING_PROFILES_ACTIVE=local
CORS_ORIGINS=http://localhost:4200

# Front : copier SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY dans
# frontend/src/environments/environment.ts (gitignored)
