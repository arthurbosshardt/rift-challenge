{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start"],
      "url": "http://localhost:4200",
      "port": 4200
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/run-backend.ps1"],
      "url": "http://localhost:8080",
      "port": 8080
    }
  ]
}
