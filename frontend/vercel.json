{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "installCommand": "npm ci",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.rift-challenge.com" }],
      "destination": "https://rift-challenge.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/challenges/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Googlebot|bingbot|Bingbot|Slurp|DuckDuckBot|Applebot).*"
        }
      ],
      "destination": "/api/challenge-preview?slug=:slug"
    },
    {
      "source": "/races/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Googlebot|bingbot|Bingbot|Slurp|DuckDuckBot|Applebot).*"
        }
      ],
      "destination": "/api/challenge-preview?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=900" }]
    }
  ]
}
